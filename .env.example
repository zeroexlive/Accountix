# Copy to .env and set real values locally. Never commit a real .env.
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# SQLite (default when DATABASE_URL is empty):
# DATABASE_URL=
# PostgreSQL example:
# DATABASE_URL=postgres://accountix:password@127.0.0.1:5432/accountix
ACCOUNTIX_DATA_DIR=
